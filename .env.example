# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta

# Jito Configuration
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_AUTH_KEYPAIR=your_base58_encoded_keypair_here
JITO_TIP_AMOUNT=0.001
JITO_REGION=ny

# Bot Configuration
BOT_PRIVATE_KEY=your_bot_private_key_base58_here
DEVELOPER_WALLET=developer_wallet_public_key_here
MAX_BUY_AMOUNT=1.0
MIN_LIQUIDITY_SOL=5.0
MAX_SLIPPAGE=1.0

# Security Settings
ENABLE_ANTI_SNIPER=true
ENABLE_SANDWICH_PROTECTION=true
MAX_TRANSACTIONS_PER_BUNDLE=5
BUNDLE_TIMEOUT_MS=5000

# Monitoring
LOG_LEVEL=info
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# DEX Configuration
RAYDIUM_PROGRAM_ID=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8
RAYDIUM_AMM_PROGRAM_ID=5quBtoiQqy3bh3btcD5yU98ZoHFrqpPQeHxP2FxNp2z3

# Rate Limiting
MAX_REQUESTS_PER_SECOND=10
COOLDOWN_PERIOD_MS=1000