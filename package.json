{
  "name": "solana-launch-protector-dev",
  "version": "1.0.0",
  "description": "Advanced anti-sniper protection for Solana token launches - Development Version",
  "main": "src/gui/main.js",
  "scripts": {
    "start": "electron src/gui/main.js",
    "dev": "NODE_ENV=development electron src/gui/main.js",
    "build": "node build-protected.js",
    "generate-license": "node license-generator.js",
    "setup": "npm install && cd src/gui/frontend && npm install",
    "test": "jest",
    "lint": "eslint src/",
    "frontend:dev": "cd src/gui/frontend && npm start",
    "frontend:build": "cd src/gui/frontend && npm run build"
  },
  "keywords": [
    "solana",
    "mev",
    "protection",
    "defi",
    "crypto",
    "trading",
    "sniper",
    "bundler"
  ],
  "author": {
    "name": "Your Company",
    "email": "support@yourwebsite.com",
    "url": "https://yourwebsite.com"
  },
  "license": "Commercial",
  "homepage": "https://yourwebsite.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourcompany/solana-protector.git"
  },
  "bugs": {
    "url": "https://github.com/yourcompany/solana-protector/issues",
    "email": "support@yourwebsite.com"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@jito-foundation/jito-ts": "^3.0.1",
    "@solana/web3.js": "^1.87.6",
    "@solana/spl-token": "^0.3.8",
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "node-machine-id": "^1.1.12",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^27.1.3",
    "electron-builder": "^24.8.1",
    "electron-is-dev": "^2.0.0",
    "electron-window-state": "^5.0.3",
    "electron-updater": "^6.1.7",
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "build": {
    "appId": "com.yourcompany.solana-protector-dev",
    "productName": "Solana Launch Protector (Dev)",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!src/**/*.test.js",
      "!src/gui/frontend/src/**/*",
      "!src/gui/frontend/public/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "Your Company",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Office",
      "synopsis": "Advanced anti-sniper protection for Solana token launches"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Solana Launch Protector",
      "include": "assets/installer.nsh",
      "deleteAppDataOnUninstall": true
    },
    "publish": {
      "provider": "github",
      "owner": "yourcompany",
      "repo": "solana-protector",
      "private": true
    }
  },
  "electronmon": {
    "patterns": [
      "src/**/*.js"
    ],
    "logLevel": "quiet"
  }
}